# Copy to src/web/.env. Replace all CHANGE_ME placeholders locally.
# Load this file explicitly in your server shell. Never send it to React.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_TEST_PASSWORD=CHANGE_ME
WAYFINDER_DATABASE_URL=postgresql+psycopg://wayfinder:CHANGE_ME@127.0.0.1:5432/wayfinder
WAYFINDER_TEST_DATABASE_URL=postgresql+psycopg://wayfinder:CHANGE_ME@127.0.0.1:5433/wayfinder_test
WAYFINDER_ENV=dev
WAYFINDER_ALLOWED_ORIGINS=[]
WAYFINDER_PUBLIC_BASE_URL=http://127.0.0.1:8000
WAYFINDER_SESSION_IDLE_DAYS=7
WAYFINDER_SESSION_ABSOLUTE_DAYS=30
WAYFINDER_LOGIN_MAX_FAILURES=5
WAYFINDER_LOGIN_FAILURE_WINDOW_MINUTES=15
WAYFINDER_EMAIL_VERIFY_TTL_HOURS=24
WAYFINDER_RESEND_VERIFICATION_PER_HOUR=3
WAYFINDER_PASSWORD_RESET_TTL_MINUTES=60
WAYFINDER_UPLOAD_MAX_MB=10
WAYFINDER_BUILD_MAX_PAGES=null
WAYFINDER_SCAN_MIN_CHARS_PER_PAGE=150
WAYFINDER_SCAN_MAX_EMPTY_PAGE_RATIO=0.5
# Calibrate with W-13 development data before enabling Vietnamese rejection.
WAYFINDER_VI_MIN_DIACRITIC_RATIO=null
WAYFINDER_BUILD_MONTHLY_MAX=null
WAYFINDER_SYSTEM_DAILY_BUILD_MAX_USD=null
WAYFINDER_SMTP_HOST=smtp.gmail.com
WAYFINDER_SMTP_PORT=587
WAYFINDER_SMTP_STARTTLS=true
WAYFINDER_SMTP_USERNAME=
WAYFINDER_SMTP_PASSWORD=
WAYFINDER_SMTP_FROM=
WAYFINDER_CONFIRMATION_TTL_HOURS=72
WAYFINDER_BUILD_HEARTBEAT_TIMEOUT_MINUTES=10
WAYFINDER_SHARE_LINK_DEFAULT_DAYS=7
WAYFINDER_COURSE_MAX_MEMBERS=200
WAYFINDER_INVITE_BATCH_MAX=50
WAYFINDER_INVITE_TTL_DAYS=7
WAYFINDER_INVITE_EMAILS_PER_DAY=200
WAYFINDER_ASSISTANT_TURNS_PER_MINUTE=10
WAYFINDER_PHASE_B_LOCK_POOL_SIZE=8
WAYFINDER_DOCUMENTS_PER_HOUR=10
WAYFINDER_MAILER=console
WAYFINDER_ARTIFACT_ROOT=C:/CHANGE_ME/wayfinder-artifacts
CLOUDINARY_URL=
WAYFINDER_CLOUDINARY_FOLDER=wayfinder/dev
WAYFINDER_SIGNED_URL_TTL_SECONDS=300
WAYFINDER_PAGE_IMAGE_WIDTH=1400
# Server only. ADC is resolved by google-auth; do not put secrets into VITE_*.
DOC2ROADMAP_LLM_TRANSPORT=vertex
DOC2ROADMAP_VERTEX_PROJECT=
DOC2ROADMAP_VERTEX_LOCATION=global
# Optional ADC service-account file path; user ADC also works.
GOOGLE_APPLICATION_CREDENTIALS=
