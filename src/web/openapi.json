          "module_count": {
            "type": "integer",
            "title": "Module Count"
          },
          "member_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Member Count"
          },
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProgressSummary"
              },
              {
                "type": "null"
              }
            ]
