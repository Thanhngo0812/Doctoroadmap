          "resume": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Resume"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "course_id",
          "doc_id",
          "title",
          "description",
          "status",
          "is_sample",
          "published_graph_version",
          "role",
          "owner",
          "module_count",
          "member_count",
          "progress",
          "resume"
        ],
        "title": "CourseCard"
      },
