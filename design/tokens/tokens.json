{
  "$schema": "https://design-tokens.github.io/community-group/format/draft-spec.json",
  "version": "1.0.0",
  "name": "WayFinder Design Tokens",
  "color": {
    "light": {
      "color-bg": { "$value": "#FFFFFF", "$type": "color" },
      "color-bg-subtle": { "$value": "#F6F8FA", "$type": "color" },
      "color-surface": { "$value": "#FFFFFF", "$type": "color" },
      "color-border": { "$value": "#DDE2E8", "$type": "color" },
      "color-border-input": { "$value": "#8994A0", "$type": "color" },
      "color-text": { "$value": "#12161B", "$type": "color" },
      "color-text-muted": { "$value": "#5B6673", "$type": "color" },
      "color-brand": { "$value": "#29A9FF", "$type": "color" },
      "color-brand-tint": { "$value": "#EAF6FF", "$type": "color" },
      "color-primary": { "$value": "#0A6AB3", "$type": "color" },
      "color-primary-text": { "$value": "#FFFFFF", "$type": "color" },
      "color-primary-hover": { "$value": "#0A5E9C", "$type": "color" },
      "color-accent": { "$value": "#FEBA4F", "$type": "color" },
      "color-accent-tint": { "$value": "#FFF4DF", "$type": "color" },
      "color-accent-text": { "$value": "#8A4F0F", "$type": "color" },
      "color-success": { "$value": "#146C3B", "$type": "color" },
      "color-success-tint": { "$value": "#E8F6EE", "$type": "color" },
      "color-danger": { "$value": "#B02F2F", "$type": "color" },
      "color-danger-tint": { "$value": "#FDECEC", "$type": "color" }
    },
    "dark": {
      "color-bg": { "$value": "#0E1217", "$type": "color" },
      "color-bg-subtle": { "$value": "#161B22", "$type": "color" },
      "color-surface": { "$value": "#161B22", "$type": "color" },
      "color-surface-2": { "$value": "#1E252E", "$type": "color" },
      "color-border": { "$value": "#2A323C", "$type": "color" },
      "color-border-input": { "$value": "#6B7785", "$type": "color" },
      "color-text": { "$value": "#E8EDF2", "$type": "color" },
      "color-text-muted": { "$value": "#9AA6B2", "$type": "color" },
      "color-primary": { "$value": "#29A9FF", "$type": "color" },
      "color-primary-text": { "$value": "#0E1217", "$type": "color" },
      "color-primary-hover": { "$value": "#52B8FF", "$type": "color" },
      "color-brand": { "$value": "#29A9FF", "$type": "color" },
      "color-brand-tint": { "$value": "rgba(41, 169, 255, 0.14)", "$type": "color" },
      "color-accent": { "$value": "#FEBA4F", "$type": "color" },
      "color-accent-tint": { "$value": "rgba(254, 186, 79, 0.14)", "$type": "color" },
      "color-accent-text": { "$value": "#FEBA4F", "$type": "color" },
      "color-success": { "$value": "#4ADE80", "$type": "color" },
      "color-success-tint": { "$value": "rgba(74, 222, 128, 0.14)", "$type": "color" },
      "color-danger": { "$value": "#F87171", "$type": "color" },
      "color-danger-tint": { "$value": "rgba(248, 113, 113, 0.14)", "$type": "color" }
    }
  },
  "typography": {
    "font-family": {
      "font-sans": { "$value": "'Be Vietnam Pro', system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily" },
      "font-mono": { "$value": "ui-monospace, 'SFMono-Regular', Consolas, monospace", "$type": "fontFamily" }
    },
    "scale": {
      "text-display": {
        "fontSize": { "desktop": "36px", "mobile": "28px" },
        "lineHeight": { "desktop": "44px", "mobile": "36px" },
        "fontWeight": 700
      },
      "text-h1": {
        "fontSize": { "desktop": "30px", "mobile": "24px" },
        "lineHeight": { "desktop": "38px", "mobile": "32px" },
        "fontWeight": 700
      },
      "text-h2": {
        "fontSize": { "desktop": "24px", "mobile": "20px" },
        "lineHeight": { "desktop": "32px", "mobile": "28px" },
        "fontWeight": 600
      },
      "text-h3": {
        "fontSize": "20px",
        "lineHeight": "28px",
        "fontWeight": 600
      },
      "text-lead": {
        "fontSize": "18px",
        "lineHeight": "30px",
        "fontWeight": 400
      },
      "text-body": {
        "fontSize": "16px",
        "lineHeight": "26px",
        "fontWeight": 400
      },
      "text-small": {
        "fontSize": "14px",
        "lineHeight": "22px",
        "fontWeight": 500
      },
      "text-caption": {
        "fontSize": "12px",
        "lineHeight": "18px",
        "fontWeight": 500
      }
    }
  },
  "spacing": {
    "space-1": { "$value": "4px", "$type": "dimension" },
    "space-2": { "$value": "8px", "$type": "dimension" },
    "space-3": { "$value": "12px", "$type": "dimension" },
    "space-4": { "$value": "16px", "$type": "dimension" },
    "space-5": { "$value": "20px", "$type": "dimension" },
    "space-6": { "$value": "24px", "$type": "dimension" },
    "space-8": { "$value": "32px", "$type": "dimension" },
    "space-10": { "$value": "40px", "$type": "dimension" },
    "space-12": { "$value": "48px", "$type": "dimension" },
    "space-16": { "$value": "64px", "$type": "dimension" }
  },
  "radius": {
    "radius-sm": { "$value": "6px", "$type": "dimension" },
    "radius-md": { "$value": "10px", "$type": "dimension" },
    "radius-lg": { "$value": "14px", "$type": "dimension" },
    "radius-xl": { "$value": "20px", "$type": "dimension" },
    "radius-pixel": { "$value": "0px", "$type": "dimension" }
  },
  "shadow": {
    "shadow-1": { "$value": "0 1px 2px rgb(18 22 27 / 0.06), 0 1px 3px rgb(18 22 27 / 0.08)", "$type": "shadow" },
    "shadow-2": { "$value": "0 8px 24px rgb(18 22 27 / 0.12)", "$type": "shadow" }
  },
  "motion": {
    "motion-fast": { "$value": "120ms", "$type": "duration" },
    "motion-base": { "$value": "200ms", "$type": "duration" },
    "motion-ease": { "$value": "ease-out", "$type": "cubicBezier" }
  },
  "breakpoint": {
    "sm": "390px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "content-max-width": "1200px",
    "reading-column-max-width": "680px"
  }
}
