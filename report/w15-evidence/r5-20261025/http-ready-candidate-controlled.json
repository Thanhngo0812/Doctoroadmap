              "name": "Mái che trong suốt"
            },
            {
              "node_id": "node_ef14a96d57f7afd0ac50ba71",
              "name": "Lưới nilon"
            },
            {
              "node_id": "node_639d613075165f0b8abbe38b",
              "name": "Khung thủy canh"
            },
            {
              "node_id": "node_35d4e6158d5d05d832e9526b",
              "name": "Rọ nhựa"
            },
            {
