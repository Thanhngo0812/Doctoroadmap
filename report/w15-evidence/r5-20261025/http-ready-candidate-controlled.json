        {
          "module_id": "module_013",
          "index": 12,
          "title": "Độ pH · Tổng lượng chất rắn hòa tan",
          "description": [
            {
              "module_ids": [
                "module_008"
              ],
              "node_ids": [
                "node_7ed0e9efad152a8b6a3de667",
                "node_bc9152eb7dd42d5a35c436e6",
                "node_256923fba35515f5523a29c7",
                "node_f410287f6627efb459659942",
                "node_ee5a91993d071374697f981b",
                "node_76ef7af51ee4025794d73335"
              ],
              "text": "Độ pH, pH của dung dịch và chất đệm giúp duy trì môi trường axit hoặc bazơ ổn định cho cây trồng. Tổng lượng chất rắn hòa tan, giá trị EC và chỉ số DO xác định nồng độ ion và lượng oxy cần thiết để cây phát triển."
            }
          ],
          "concepts": [
            {
              "node_id": "node_7ed0e9efad152a8b6a3de667",
              "name": "Độ pH"
            },
