          }
        },
        {
          "module_id": "module_016",
          "index": 15,
          "title": "Chuẩn bị dung dịch dinh dưỡng",
          "description": [
            {
              "module_ids": [
                "module_015"
              ],
              "node_ids": [
                "node_3893ed8b63c4df54d30a070e"
              ],
              "text": "Dung dịch gốc đậm đặc được pha loãng theo tỉ lệ quy định để tạo thành dung dịch dinh dưỡng nuôi cây. Việc này đảm bảo cung cấp đủ dưỡng chất cần thiết cho sự phát triển của cây trồng."
            }
          ],
