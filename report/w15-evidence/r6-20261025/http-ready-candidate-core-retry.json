              "name": "Khung thủy canh"
            },
            {
              "node_id": "node_35d4e6158d5d05d832e9526b",
              "name": "Rọ nhựa"
            },
            {
              "node_id": "node_8648ac7801815681e79e805f",
              "name": "Phương pháp đục lỗ"
            },
            {
